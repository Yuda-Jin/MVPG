+from typing import Any
+
+import torch
+import torch.nn as nn
+from transformers import BitImageProcessor
+from transformers.models.dinov2 import Dinov2Config, Dinov2Model
+
+
+class DINOVisionTower(nn.Module):
+    def __init__(self, args, delay_load=False) -> None:
+        super().__init__()
+
+        self.is_loaded = False
+
+        self.vision_tower_name = getattr(args, 'mm_vision_tower', None)
+        print(f"Loading DINO vision tower {self.vision_tower_name}")
+        self.select_layer = args.mm_vision_select_layer
+        self.select_feature = getattr(args, 'mm_vision_select_feature', 'patch')
+
+        assert self.select_layer == -1, f"DINO only supports extracting last layer features, got {self.select_layer}"
+        assert self.select_feature == "patch", f"DINO only supports extracting patch features, got f{self.select_feature}"
+
+        if not delay_load:
+            self.load_model()
+        else:
+            self.cfg_only = Dinov2Config.from_pretrained(self.vision_tower_name)
+
+    def load_model(self, skip_loading_weights: bool = False) -> None:
+        """Loads the vision tower specified in the present object. This will download checkpoints from HuggingFace.
+
+        :param skip_loading_weights: If True, the vision tower will only be initialized, but no weights will be
+            loaded. Use this for debugging. Defaults to False
+        """
+        self.image_processor = BitImageProcessor.from_pretrained(self.vision_tower_name)
+
+        if self.image_processor.crop_size["height"] != 518:
+            raise ValueError(f"self.image_processor.crop_size['height'] should be 518, got {self.image_processor.crop_size['height']}")
+            raise ValueError(f"self.image_processor.crop_size['width'] should be 518, got {self.image_processor.crop_size['width']}")
+
+        if self.image_processor.size["shortest_edge"] != self.image_processor.crop_size["height"]:
+            raise ValueError(f"self.image_processor.size['shortest_edge'] should be equal to self.image_processor.crop_size['height'], got {self.image_processor.size['shortest_edge']}")
+
+        if skip_loading_weights:
+            vision_config = Dinov2Config.from_pretrained(self.vision_tower_name)
+            self.vision_tower = Dinov2Model(config=vision_config)
+        else:
+            self.vision_tower = Dinov2Model.from_pretrained(self.vision_tower_name)
+        self.vision_tower.requires_grad_(False)
+
+        self.is_loaded = True
+
+    @torch.no_grad()
+    def forward(self, images, **kwargs) -> Any:
+        if type(images) is list:
+            image_features = []
+            for image in images:
+                image_forward_out = self.vision_tower(image.to(device=self.device, dtype=self.dtype).unsqueeze(0), output_hidden_states=True)
+                image_feature = image_forward_out.last_hidden_state[:, 1:].to(image.dtype)
+                image_features.append(image_feature)
+        else:
+            if "output_attentions" in kwargs.keys():
+                image_forward_outs = self.vision_tower(images.to(device=self.device, dtype=self.dtype), output_hidden_states=True, output_attentions=kwargs['output_attentions'])
+            else:
+                image_forward_outs = self.vision_tower(images.to(device=self.device, dtype=self.dtype), output_hidden_states=True)
+            image_features = image_forward_outs.last_hidden_state[:, 1:].to(images.dtype)
+        if "output_attentions" not in kwargs.keys():
+            return image_features
+        else:
+            return image_features, image_forward_outs.attentions
+
+    @property
+    def dummy_feature(self) -> torch.Tensor:
+        return torch.zeros(1, self.hidden_size, device=self.device, dtype=self.dtype)
+
+    @property
+    def dtype(self) -> Any:
+        return self.vision_tower.dtype
+
+    @property
+    def device(self) -> Any:
+        return self.vision_tower.device
+
+    @property
+    def config(self) -> Any:
+        if self.is_loaded:
+            return self.vision_tower.config
+        else:
+            return self.cfg_only
+
+    @property
+    def hidden_size(self) -> Any:
+        return self.config.hidden_size
+
+    @property
+    def num_patches(self) -> Any:
+        return (self.config.image_size // self.config.patch_size) ** 2
