+def get_max_num_cores_per_gpu() -> int:
+    """
+    Returns the maximum possible number of cpu cores per GPU.
+
+    This function calculates the maximum number of cpu cores per GPU by dividing the total number of cpu cores by the number of GPUs.
+
+    Returns:
+        int: The maximum number of cpu cores per GPU.
+    """
+    num_cpus = os.cpu_count()
+    assert num_cpus is not None  # for mypy
+    print(f"Device has {num_cpus=}")
+    num_devices = max(1, torch.cuda.device_count())
+    # We ensure num_devices is not 0 for non-GPU machines
+    # to avoid division by zero error when computing `workers_per_gpu`
+    num_cores_per_gpu = num_cpus // num_devices
+    return num_cores_per_gpu
+
+
+def get_max_num_dataloaders(num_dataloaders: int) -> int:
+    """
+    Returns the maximum number of dataloaders to be used for data loading.
+
+    Args:
+        num_dataloaders (int): The current number of dataloaders to be used.
+
+    Returns:
+        int: The maximum number of dataloaders to be used considering the number of GPUs and CPU cores.
+    """
+    max_num_cores_per_gpu = get_max_num_cores_per_gpu()
+    return max(num_dataloaders, max_num_cores_per_gpu)
